          <mxGeometry x="20" y="166" width="300" height="96" as="geometry" />
        </mxCell>
        <mxCell id="y_sa" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">LIVE</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Super admin</div><div style="font-size:11px;color:#3B3630;margin-top:2px">Invites and roles, plus the interactive backend map narrated to the panel.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#FFFFFF;strokeColor=#1F5C3D;strokeWidth=2;dashed=0;" vertex="1" parent="y_staff">
          <mxGeometry x="20" y="276" width="300" height="96" as="geometry" />
        </mxCell>
