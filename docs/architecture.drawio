        </mxCell>
        <mxCell id="y_sol" value="&lt;div style=&quot;font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B&quot;&gt;BLOCKED&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#141210;margin-top:1px&quot;&gt;Telnyx AI Assistant &quot;Sol&quot;&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#3B3630;margin-top:2px&quot;&gt;Voice runtime. Blocked on account funding, not on design.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#FFFFFF;strokeColor=#8C2F1F;strokeWidth=3;dashed=1;dashPattern=2 3;" vertex="1" parent="y_rt">
          <mxGeometry x="20" y="276" width="340" height="96" as="geometry" />
        </mxCell>
        <mxCell id="y_ev" value="&lt;div style=&quot;font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B&quot;&gt;PENDING&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#141210;margin-top:1px&quot;&gt;/api/telnyx/events&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#3B3630;margin-top:2px&quot;&gt;Verifies the signature, diffs the cumulative history, inserts only new turns.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#FFFFFF;strokeColor=#8A6A1F;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="y_rt">
