        <mxCell id="r_gw" value="&lt;div style=&quot;font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B&quot;&gt;FUTURE  [fallback 2]&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#141210;margin-top:1px&quot;&gt;Model gateway&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#3B3630;margin-top:2px&quot;&gt;Anthropic API primary, Amazon Bedrock (Claude) standby. Timeouts, retries, circuit breaker, token budget.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#F2EEE7;strokeColor=#2E2A26;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="c_rt">
