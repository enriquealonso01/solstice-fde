        <mxCell id="future_e41" value="SSO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#3B3630;strokeWidth=1.6;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#141210;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="e_sso" target="t_adm">
