<mxfile host="app.diagrams.net" agent="solstice-fde" type="device" version="24.7.17">
  <diagram id="future" name="Future state (production)">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="1670" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c_guest" value="<div style="font-size:15px;font-weight:700;color:#141210">Guest channels</div><div style="font-size:10px;font-weight:400;color:#5A534B">Where a guest starts</div>" style="swimlane;html=1;startSize=56;rounded=1;arcSize=3;fillColor=#EDE5D8;strokeColor=#6B625A;strokeWidth=2;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;swimlaneFillColor=#FBF8F3;horizontal=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="340" height="608" as="geometry" />
        </mxCell>
        <mxCell id="g_chat" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">TODAY</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Web chat widget</div><div style="font-size:11px;color:#3B3630;margin-top:2px">React SPA on the Solstice site. Streaming replies, tool chips, inline policy citations.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#FFFFFF;strokeColor=#1F5C3D;strokeWidth=2;dashed=0;" vertex="1" parent="c_guest">
          <mxGeometry x="20" y="56" width="300" height="96" as="geometry" />
        </mxCell>
        <mxCell id="g_sms" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">FUTURE</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">SMS and WhatsApp</div><div style="font-size:11px;color:#3B3630;margin-top:2px">Telnyx Messaging. Same agent, same tools, asynchronous turns. Today: outbound only.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#F2EEE7;strokeColor=#2E2A26;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="c_guest">
          <mxGeometry x="20" y="166" width="300" height="96" as="geometry" />
        </mxCell>
        <mxCell id="g_form" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">FUTURE</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Group inquiry intake</div><div style="font-size:11px;color:#3B3630;margin-top:2px">Website portal form and the shared sales inbox. Today: the provided CSV export, seeded once.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#F2EEE7;strokeColor=#2E2A26;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="c_guest">
          <mxGeometry x="20" y="276" width="300" height="96" as="geometry" />
        </mxCell>
        <mxCell id="g_pstn" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">TODAY</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Phone call (PSTN)</div><div style="font-size:11px;color:#3B3630;margin-top:2px">Published Telnyx DID. Sol answers with the same greeting as the chat widget.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#FFFFFF;strokeColor=#1F5C3D;strokeWidth=2;dashed=0;" vertex="1" parent="c_guest">
          <mxGeometry x="20" y="386" width="300" height="96" as="geometry" />
        </mxCell>
        <mxCell id="g_webrtc" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">FUTURE</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Browser voice</div><div style="font-size:11px;color:#3B3630;margin-top:2px">@telnyx/webrtc mic inside the same widget, same assistant as the phone line.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#F2EEE7;strokeColor=#2E2A26;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="c_guest">
          <mxGeometry x="20" y="496" width="300" height="96" as="geometry" />
        </mxCell>
        <mxCell id="c_sec" value="<div style="font-size:15px;font-weight:700;color:#141210">Security, secrets and tenancy</div><div style="font-size:10px;font-weight:400;color:#5A534B">Cross-cutting</div>" style="swimlane;html=1;startSize=56;rounded=1;arcSize=3;fillColor=#EDE5D8;strokeColor=#6B625A;strokeWidth=2;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;swimlaneFillColor=#FBF8F3;horizontal=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="758" width="340" height="498" as="geometry" />
        </mxCell>
        <mxCell id="s_secrets" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">FUTURE</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Secrets and keys</div><div style="font-size:11px;color:#3B3630;margin-top:2px">AWS Secrets Manager and KMS, rotated. Today: Netlify env vars; only the Supabase anon key reaches the browser.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#F2EEE7;strokeColor=#2E2A26;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="c_sec">
          <mxGeometry x="20" y="56" width="300" height="96" as="geometry" />
        </mxCell>
        <mxCell id="s_tenant" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">FUTURE</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Per-tenant isolation</div><div style="font-size:11px;color:#3B3630;margin-top:2px">tenant_id per brand and property, enforced by Postgres RLS. 140 properties on one cluster, not 140 stacks.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#F2EEE7;strokeColor=#2E2A26;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="c_sec">
          <mxGeometry x="20" y="166" width="300" height="96" as="geometry" />
        </mxCell>
        <mxCell id="s_pii" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">TODAY</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">PII masking and retention</div><div style="font-size:11px;color:#3B3630;margin-top:2px">Masked at the tool boundary before any model or log sees it. Future: retention sweep, zero-retention model terms.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#FFFFFF;strokeColor=#1F5C3D;strokeWidth=2;dashed=0;" vertex="1" parent="c_sec">
          <mxGeometry x="20" y="276" width="300" height="96" as="geometry" />
        </mxCell>
        <mxCell id="s_kill" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">FUTURE</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Kill switch and rollout</div><div style="font-size:11px;color:#3B3630;margin-top:2px">Off per property and per capability. Shadow mode, then a three to five property pilot, then the estate.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#F2EEE7;strokeColor=#2E2A26;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="c_sec">
          <mxGeometry x="20" y="386" width="300" height="96" as="geometry" />
        </mxCell>
        <mxCell id="c_edge" value="<div style="font-size:15px;font-weight:700;color:#141210">Edge and identity</div><div style="font-size:10px;font-weight:400;color:#5A534B">Public boundary</div>" style="swimlane;html=1;startSize=56;rounded=1;arcSize=3;fillColor=#EDE5D8;strokeColor=#6B625A;strokeWidth=2;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;swimlaneFillColor=#FBF8F3;horizontal=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="110" width="340" height="388" as="geometry" />
        </mxCell>
        <mxCell id="e_cdn" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">FUTURE</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">CDN and WAF</div><div style="font-size:11px;color:#3B3630;margin-top:2px">Amazon CloudFront and AWS WAF. Today: the Netlify CDN with an SPA rewrite.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#F2EEE7;strokeColor=#2E2A26;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="c_edge">
          <mxGeometry x="20" y="56" width="300" height="96" as="geometry" />
        </mxCell>
        <mxCell id="e_gw" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">FUTURE</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">API gateway</div><div style="font-size:11px;color:#3B3630;margin-top:2px">Authentication, rate limits and a per-tenant quota in front of every agent call.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#F2EEE7;strokeColor=#2E2A26;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="c_edge">
          <mxGeometry x="20" y="166" width="300" height="96" as="geometry" />
        </mxCell>
        <mxCell id="e_sso" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">FUTURE</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Staff SSO</div><div style="font-size:11px;color:#3B3630;margin-top:2px">Okta or Microsoft Entra ID with SCIM. Today: Supabase Auth and three scoped logins.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#F2EEE7;strokeColor=#2E2A26;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="c_edge">
          <mxGeometry x="20" y="276" width="300" height="96" as="geometry" />
        </mxCell>
        <mxCell id="c_voice" value="<div style="font-size:15px;font-weight:700;color:#141210">Telephony and voice</div><div style="font-size:10px;font-weight:400;color:#5A534B">Telnyx, managed</div>" style="swimlane;html=1;startSize=56;rounded=1;arcSize=3;fillColor=#EDE5D8;strokeColor=#6B625A;strokeWidth=2;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;swimlaneFillColor=#FBF8F3;horizontal=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="538" width="340" height="608" as="geometry" />
        </mxCell>
        <mxCell id="v_cc" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">TODAY</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Telnyx Programmable Voice</div><div style="font-size:11px;color:#3B3630;margin-top:2px">Call Control legs over SIP. Every leg is ordinary Call Control, which is why supervision works.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#FFFFFF;strokeColor=#1F5C3D;strokeWidth=2;dashed=0;" vertex="1" parent="c_voice">
          <mxGeometry x="20" y="56" width="300" height="96" as="geometry" />
        </mxCell>
        <mxCell id="v_sol" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">TODAY</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">AI Assistant &quot;Sol&quot;</div><div style="font-size:11px;color:#3B3630;margin-top:2px">Voice runtime: turn-taking, barge-in, ASR and TTS. Config generated from agent/sol.md.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#FFFFFF;strokeColor=#1F5C3D;strokeWidth=2;dashed=0;" vertex="1" parent="c_voice">
          <mxGeometry x="20" y="166" width="300" height="96" as="geometry" />
        </mxCell>
        <mxCell id="v_hist" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">TODAY</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Transcript events</div><div style="font-size:11px;color:#3B3630;margin-top:2px">call.ai_gather.message_history_updated, one event per turn, diffed before insert.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#FFFFFF;strokeColor=#1F5C3D;strokeWidth=2;dashed=0;" vertex="1" parent="c_voice">
          <mxGeometry x="20" y="276" width="300" height="96" as="geometry" />
        </mxCell>
        <mxCell id="v_sup" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">TODAY</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Supervisor leg</div><div style="font-size:11px;color:#3B3630;margin-top:2px">supervise_call_control_id, switch_supervisor_role, then ai_assistant_stop for a full handover.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#FFFFFF;strokeColor=#1F5C3D;strokeWidth=2;dashed=0;" vertex="1" parent="c_voice">
          <mxGeometry x="20" y="386" width="300" height="96" as="geometry" />
        </mxCell>
        <mxCell id="v_fail" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">FUTURE  [fallback 3]</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Carrier failover</div><div style="font-size:11px;color:#3B3630;margin-top:2px">Standby DID on a second carrier. The number on the site is runtime config, not a build constant.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#F2EEE7;strokeColor=#2E2A26;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="c_voice">
          <mxGeometry x="20" y="496" width="300" height="96" as="geometry" />
        </mxCell>
        <mxCell id="c_rt" value="<div style="font-size:15px;font-weight:700;color:#141210">Agent runtime</div><div style="font-size:10px;font-weight:400;color:#5A534B">Amazon ECS Fargate, private subnets. This is where the agent runs.</div>" style="swimlane;html=1;startSize=56;rounded=1;arcSize=3;fillColor=#EDE5D8;strokeColor=#6B625A;strokeWidth=2;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;swimlaneFillColor=#FBF8F3;horizontal=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="110" width="380" height="718" as="geometry" />
        </mxCell>
        <mxCell id="r_def" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">TODAY</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Agent definition registry</div><div style="font-size:11px;color:#3B3630;margin-top:2px">agent/sol.md compiles to the Telnyx assistant JSON and the Claude system prompt. One definition, two runtimes.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#FFFFFF;strokeColor=#1F5C3D;strokeWidth=2;dashed=0;" vertex="1" parent="c_rt">
          <mxGeometry x="20" y="56" width="340" height="96" as="geometry" />
        </mxCell>
        <mxCell id="r_orch" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">FUTURE</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Chat orchestrator</div><div style="font-size:11px;color:#3B3630;margin-top:2px">Stateless container on ECS Fargate, autoscaled. Today: the same code as a Netlify Function at /api/chat.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#F2EEE7;strokeColor=#2E2A26;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="c_rt">
          <mxGeometry x="20" y="166" width="340" height="96" as="geometry" />
        </mxCell>
        <mxCell id="r_gw" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">FUTURE  [fallback 2]</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Model gateway</div><div style="font-size:11px;color:#3B3630;margin-top:2px">Anthropic API primary, Amazon Bedrock (Claude) standby. Timeouts, retries, circuit breaker, token budget.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#F2EEE7;strokeColor=#2E2A26;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="c_rt">
          <mxGeometry x="20" y="276" width="340" height="96" as="geometry" />
        </mxCell>
        <mxCell id="r_tools" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">TODAY</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Tool service</div><div style="font-size:11px;color:#3B3630;margin-top:2px">identify_guest, get_reservation, get_policy, evaluate_group_rules, price_block, availability_service.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#FFFFFF;strokeColor=#1F5C3D;strokeWidth=2;dashed=0;" vertex="1" parent="c_rt">
          <mxGeometry x="20" y="386" width="340" height="96" as="geometry" />
        </mxCell>
        <mxCell id="r_rules" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">TODAY</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Rules engine</div><div style="font-size:11px;color:#3B3630;margin-top:2px">Thresholds, seasonal caps and blackouts live in src/lib/rules as data, never inside a prompt.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#FFFFFF;strokeColor=#1F5C3D;strokeWidth=2;dashed=0;" vertex="1" parent="c_rt">
          <mxGeometry x="20" y="496" width="340" height="96" as="geometry" />
        </mxCell>
        <mxCell id="r_env" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">TODAY</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">ToolResult envelope</div><div style="font-size:11px;color:#3B3630;margin-top:2px">ok, grounded, citations, masked_fields, latency_ms. grounded:false is a checkable order to escalate.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#FFFFFF;strokeColor=#1F5C3D;strokeWidth=2;dashed=0;" vertex="1" parent="c_rt">
          <mxGeometry x="20" y="606" width="340" height="96" as="geometry" />
        </mxCell>
        <mxCell id="c_async" value="<div style="font-size:15px;font-weight:700;color:#141210">Async work</div><div style="font-size:10px;font-weight:400;color:#5A534B">Amazon SQS and Fargate workers</div>" style="swimlane;html=1;startSize=56;rounded=1;arcSize=3;fillColor=#EDE5D8;strokeColor=#6B625A;strokeWidth=2;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;swimlaneFillColor=#FBF8F3;horizontal=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="868" width="380" height="388" as="geometry" />
        </mxCell>
        <mxCell id="a_q" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">FUTURE</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Queue</div><div style="font-size:11px;color:#3B3630;margin-top:2px">Amazon SQS with a dead-letter queue: proposal render and send, PMS writes behind an approval gate, webhook ingest.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#F2EEE7;strokeColor=#2E2A26;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="c_async">
          <mxGeometry x="20" y="56" width="340" height="96" as="geometry" />
        </mxCell>
        <mxCell id="a_w" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">FUTURE</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Workers</div><div style="font-size:11px;color:#3B3630;margin-top:2px">Idempotent container workers. Retry with backoff; the dead-letter queue is alerted on, never drained silently.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#F2EEE7;strokeColor=#2E2A26;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="c_async">
          <mxGeometry x="20" y="166" width="340" height="96" as="geometry" />
        </mxCell>
        <mxCell id="a_job" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">FUTURE</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Reconciliation and jobs</div><div style="font-size:11px;color:#3B3630;margin-top:2px">Nightly PMS and CRS reconciliation, rate-cache warm, transcript retention sweep.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#F2EEE7;strokeColor=#2E2A26;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="c_async">
          <mxGeometry x="20" y="276" width="340" height="96" as="geometry" />
        </mxCell>
        <mxCell id="c_data" value="<div style="font-size:15px;font-weight:700;color:#141210">Data platform</div><div style="font-size:10px;font-weight:400;color:#5A534B">Solstice-owned, per-tenant</div>" style="swimlane;html=1;startSize=56;rounded=1;arcSize=3;fillColor=#EDE5D8;strokeColor=#6B625A;strokeWidth=2;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;swimlaneFillColor=#FBF8F3;horizontal=1;" vertex="1" parent="1">
          <mxGeometry x="1220" y="110" width="380" height="718" as="geometry" />
        </mxCell>
        <mxCell id="d_acl" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">FUTURE  [fallback 1]</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Anti-corruption layer</div><div style="font-size:11px;color:#3B3630;margin-top:2px">The only component that knows a vendor field name. Read-only credentials first; writes queue behind approval.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#F2EEE7;strokeColor=#2E2A26;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="c_data">
          <mxGeometry x="20" y="56" width="340" height="96" as="geometry" />
        </mxCell>
        <mxCell id="d_cache" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">FUTURE  [fallback 1]</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Read cache</div><div style="font-size:11px;color:#3B3630;margin-top:2px">Amazon ElastiCache (Redis) for reservations, policies and rates. TTL plus a stale_as_of stamp on every hit.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#F2EEE7;strokeColor=#2E2A26;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="c_data">
          <mxGeometry x="20" y="166" width="340" height="96" as="geometry" />
        </mxCell>
        <mxCell id="d_pg" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">FUTURE  [fallback 5]</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Operational Postgres</div><div style="font-size:11px;color:#3B3630;margin-top:2px">Amazon RDS Multi-AZ. The same RLS policies that run on Supabase today move across unchanged.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#F2EEE7;strokeColor=#2E2A26;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="c_data">
          <mxGeometry x="20" y="276" width="340" height="96" as="geometry" />
        </mxCell>
        <mxCell id="d_rt" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">TODAY  [fallback 6]</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Realtime fan-out</div><div style="font-size:11px;color:#3B3630;margin-top:2px">Supabase Realtime on sessions, messages, tool_invocations and inquiries. Future: Postgres CDC.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#FFFFFF;strokeColor=#1F5C3D;strokeWidth=2;dashed=0;" vertex="1" parent="c_data">
          <mxGeometry x="20" y="386" width="340" height="96" as="geometry" />
        </mxCell>
        <mxCell id="d_s3" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">FUTURE</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Object storage</div><div style="font-size:11px;color:#3B3630;margin-top:2px">Amazon S3 with time-limited signed URLs for proposal PDFs. Today: Supabase Storage.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#F2EEE7;strokeColor=#2E2A26;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="c_data">
          <mxGeometry x="20" y="496" width="340" height="96" as="geometry" />
        </mxCell>
        <mxCell id="d_qa" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">TODAY</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Data-quality quarantine</div><div style="font-size:11px;color:#3B3630;margin-top:2px">SOL-PVD base_rate_suite is -395. Flagged and excluded, never priced from, in every environment.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#FFFFFF;strokeColor=#1F5C3D;strokeWidth=2;dashed=0;" vertex="1" parent="c_data">
          <mxGeometry x="20" y="606" width="340" height="96" as="geometry" />
        </mxCell>
        <mxCell id="c_del" value="<div style="font-size:15px;font-weight:700;color:#141210">Delivery</div><div style="font-size:10px;font-weight:400;color:#5A534B">One adapter, swappable providers</div>" style="swimlane;html=1;startSize=56;rounded=1;arcSize=3;fillColor=#EDE5D8;strokeColor=#6B625A;strokeWidth=2;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;swimlaneFillColor=#FBF8F3;horizontal=1;" vertex="1" parent="1">
          <mxGeometry x="1220" y="978" width="380" height="498" as="geometry" />
        </mxCell>
        <mxCell id="l_ad" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">TODAY</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Channel adapter</div><div style="font-size:11px;color:#3B3630;margin-top:2px">Email if there is an address, SMS if there is only a number, flagged for a human if neither.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#FFFFFF;strokeColor=#1F5C3D;strokeWidth=2;dashed=0;" vertex="1" parent="c_del">
          <mxGeometry x="20" y="56" width="340" height="96" as="geometry" />
        </mxCell>
        <mxCell id="l_em" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">TODAY</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Telnyx Email API</div><div style="font-size:11px;color:#3B3630;margin-top:2px">Branded HTML with the PDF attached. One provider across voice, SMS and email.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#FFFFFF;strokeColor=#1F5C3D;strokeWidth=2;dashed=0;" vertex="1" parent="c_del">
          <mxGeometry x="20" y="166" width="340" height="96" as="geometry" />
        </mxCell>
        <mxCell id="l_sms" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">TODAY</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Telnyx SMS (10DLC)</div><div style="font-size:11px;color:#3B3630;margin-top:2px">Short message plus a signed link to the PDF. Blocked on carrier registration, not on code.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#FFFFFF;strokeColor=#1F5C3D;strokeWidth=2;dashed=0;" vertex="1" parent="c_del">
          <mxGeometry x="20" y="276" width="340" height="96" as="geometry" />
        </mxCell>
        <mxCell id="l_bk" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">FUTURE  [fallback 4]</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Backup sender</div><div style="font-size:11px;color:#3B3630;margin-top:2px">Amazon SES behind the same adapter. If every sender fails the proposal stays queued and reads as not sent.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#F2EEE7;strokeColor=#2E2A26;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="c_del">
          <mxGeometry x="20" y="386" width="340" height="96" as="geometry" />
        </mxCell>
        <mxCell id="c_up" value="<div style="font-size:15px;font-weight:700;color:#141210">Upstream systems of record</div><div style="font-size:10px;font-weight:400;color:#5A534B">Where guest and reservation data actually comes from</div>" style="swimlane;html=1;startSize=56;rounded=1;arcSize=3;fillColor=#EDE5D8;strokeColor=#6B625A;strokeWidth=2;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;swimlaneFillColor=#FBF8F3;horizontal=1;" vertex="1" parent="1">
          <mxGeometry x="1640" y="110" width="340" height="608" as="geometry" />
        </mxCell>
        <mxCell id="u_pms" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">FUTURE</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Property management system</div><div style="font-size:11px;color:#3B3630;margin-top:2px">Oracle OPERA Cloud through the Hospitality Integration Platform; Mews, Cloudbeds or Agilysys elsewhere.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#F2EEE7;strokeColor=#2E2A26;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="c_up">
          <mxGeometry x="20" y="56" width="300" height="96" as="geometry" />
        </mxCell>
        <mxCell id="u_crs" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">FUTURE</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Central reservation system</div><div style="font-size:11px;color:#3B3630;margin-top:2px">SynXis, Amadeus or a brand-built CRS. Rates, availability and channel distribution.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#F2EEE7;strokeColor=#2E2A26;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="c_up">
          <mxGeometry x="20" y="166" width="300" height="96" as="geometry" />
        </mxCell>
        <mxCell id="u_crm" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">FUTURE</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Loyalty and CRM</div><div style="font-size:11px;color:#3B3630;margin-top:2px">Revinate, Cendyn or Salesforce Marketing Cloud. Tier, points, stay history and opt-in.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#F2EEE7;strokeColor=#2E2A26;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="c_up">
          <mxGeometry x="20" y="276" width="300" height="96" as="geometry" />
        </mxCell>
        <mxCell id="u_sc" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">FUTURE</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Sales and catering</div><div style="font-size:11px;color:#3B3630;margin-top:2px">Amadeus Delphi. Group blocks, function space and signed contracts.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#F2EEE7;strokeColor=#2E2A26;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="c_up">
          <mxGeometry x="20" y="386" width="300" height="96" as="geometry" />
        </mxCell>
        <mxCell id="u_csv" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">TODAY</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Provided CSV exports</div><div style="font-size:11px;color:#3B3630;margin-top:2px">Guest profiles, properties, group inquiries and the front-desk policy reference. Seeded once.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#FFFFFF;strokeColor=#1F5C3D;strokeWidth=2;dashed=0;" vertex="1" parent="c_up">
          <mxGeometry x="20" y="496" width="300" height="96" as="geometry" />
        </mxCell>
        <mxCell id="c_staff" value="<div style="font-size:15px;font-weight:700;color:#141210">Staff surfaces</div><div style="font-size:10px;font-weight:400;color:#5A534B">Three scoped logins, scoped in Postgres</div>" style="swimlane;html=1;startSize=56;rounded=1;arcSize=3;fillColor=#EDE5D8;strokeColor=#6B625A;strokeWidth=2;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;swimlaneFillColor=#FBF8F3;horizontal=1;" vertex="1" parent="1">
          <mxGeometry x="1640" y="758" width="340" height="498" as="geometry" />
        </mxCell>
        <mxCell id="t_sup" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">TODAY</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Concierge supervisor</div><div style="font-size:11px;color:#3B3630;margin-top:2px">Live sessions, streaming transcript, tool trace, and listen, whisper, barge, take over.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#FFFFFF;strokeColor=#1F5C3D;strokeWidth=2;dashed=0;" vertex="1" parent="c_staff">
          <mxGeometry x="20" y="56" width="300" height="96" as="geometry" />
        </mxCell>
        <mxCell id="t_grp" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">TODAY</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Group sales console</div><div style="font-size:11px;color:#3B3630;margin-top:2px">Inquiry inbox, rule verdicts, generated proposal, side chat, and Accept and send.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#FFFFFF;strokeColor=#1F5C3D;strokeWidth=2;dashed=0;" vertex="1" parent="c_staff">
          <mxGeometry x="20" y="166" width="300" height="96" as="geometry" />
        </mxCell>
        <mxCell id="t_adm" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">TODAY</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Super admin</div><div style="font-size:11px;color:#3B3630;margin-top:2px">Invites and roles, plus the interactive system map this diagram was generated from.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#FFFFFF;strokeColor=#1F5C3D;strokeWidth=2;dashed=0;" vertex="1" parent="c_staff">
          <mxGeometry x="20" y="276" width="300" height="96" as="geometry" />
        </mxCell>
        <mxCell id="t_esc" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">FUTURE</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Escalation queue</div><div style="font-size:11px;color:#3B3630;margin-top:2px">On-call rota and an SLA timer. The human opens with everything the agent already tried.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#F2EEE7;strokeColor=#2E2A26;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="c_staff">
          <mxGeometry x="20" y="386" width="300" height="96" as="geometry" />
        </mxCell>
        <mxCell id="c_obs" value="<div style="font-size:15px;font-weight:700;color:#141210">Observability, operations and release</div><div style="font-size:10px;font-weight:400;color:#5A534B">Cross-cutting: every service above emits here</div>" style="swimlane;html=1;startSize=56;rounded=1;arcSize=3;fillColor=#EDE5D8;strokeColor=#6B625A;strokeWidth=2;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;swimlaneFillColor=#FBF8F3;horizontal=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="1446" width="2420" height="168" as="geometry" />
        </mxCell>
        <mxCell id="o_ci" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">FUTURE</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">CI/CD and release gates</div><div style="font-size:11px;color:#3B3630;margin-top:2px">GitHub Actions to an image, rolling ECS deploy. Typecheck, rules tests and a golden-transcript run gate every release.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#F2EEE7;strokeColor=#2E2A26;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="c_obs">
          <mxGeometry x="20" y="56" width="320" height="96" as="geometry" />
        </mxCell>
        <mxCell id="o_log" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">FUTURE</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Structured logs</div><div style="font-size:11px;color:#3B3630;margin-top:2px">JSON correlated by session_id to CloudWatch Logs. Masked at the source, so no log can leak PII.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#F2EEE7;strokeColor=#2E2A26;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="c_obs">
          <mxGeometry x="360" y="56" width="320" height="96" as="geometry" />
        </mxCell>
        <mxCell id="o_otel" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">FUTURE</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Traces and metrics</div><div style="font-size:11px;color:#3B3630;margin-top:2px">OpenTelemetry SDK and Collector to Grafana Cloud. One trace per turn: model, tools, PMS, delivery.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#F2EEE7;strokeColor=#2E2A26;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="c_obs">
          <mxGeometry x="700" y="56" width="320" height="96" as="geometry" />
        </mxCell>
        <mxCell id="o_llm" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">FUTURE</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">LLM observability</div><div style="font-size:11px;color:#3B3630;margin-top:2px">Langfuse: prompt version, tokens, cost, tool path and groundedness rate per release.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#F2EEE7;strokeColor=#2E2A26;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="c_obs">
          <mxGeometry x="1040" y="56" width="320" height="96" as="geometry" />
        </mxCell>
        <mxCell id="o_slo" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">FUTURE</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Dashboards and SLOs</div><div style="font-size:11px;color:#3B3630;margin-top:2px">p95 per tool and per channel, containment rate, escalation rate, delivery success, cache staleness.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#F2EEE7;strokeColor=#2E2A26;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="c_obs">
          <mxGeometry x="1380" y="56" width="320" height="96" as="geometry" />
        </mxCell>
        <mxCell id="o_alert" value="<div style="font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B">FUTURE</div><div style="font-size:13px;font-weight:700;color:#141210;margin-top:1px">Alerting and on-call</div><div style="font-size:11px;color:#3B3630;margin-top:2px">PagerDuty on SLO burn, an open circuit, a grounded:false spike, queue depth or a delivery failure.</div>" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#F2EEE7;strokeColor=#2E2A26;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="c_obs">
          <mxGeometry x="1720" y="56" width="320" height="96" as="geometry" />
