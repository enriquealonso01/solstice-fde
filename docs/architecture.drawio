        <mxCell id="c_sec" value="&lt;div style=&quot;font-size:15px;font-weight:700;color:#141210&quot;&gt;Security, secrets and tenancy&lt;/div&gt;&lt;div style=&quot;font-size:10px;font-weight:400;color:#5A534B&quot;&gt;Cross-cutting&lt;/div&gt;" style="swimlane;html=1;startSize=56;rounded=1;arcSize=3;fillColor=#EDE5D8;strokeColor=#6B625A;strokeWidth=2;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;swimlaneFillColor=#FBF8F3;horizontal=1;" vertex="1" parent="1">
