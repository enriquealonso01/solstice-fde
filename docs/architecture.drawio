        <mxCell id="l_sms" value="&lt;div style=&quot;font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B&quot;&gt;TODAY&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#141210;margin-top:1px&quot;&gt;Telnyx SMS (10DLC)&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#3B3630;margin-top:2px&quot;&gt;Short message plus a signed link to the PDF. Blocked on carrier registration, not on code.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#FFFFFF;strokeColor=#1F5C3D;strokeWidth=2;dashed=0;" vertex="1" parent="c_del">
