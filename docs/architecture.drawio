        </mxCell>
        <mxCell id="c_async" value="&lt;div style=&quot;font-size:15px;font-weight:700;color:#141210&quot;&gt;Async work&lt;/div&gt;&lt;div style=&quot;font-size:10px;font-weight:400;color:#5A534B&quot;&gt;Amazon SQS and Fargate workers&lt;/div&gt;" style="swimlane;html=1;startSize=56;rounded=1;arcSize=3;fillColor=#EDE5D8;strokeColor=#6B625A;strokeWidth=2;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;swimlaneFillColor=#FBF8F3;horizontal=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="868" width="380" height="388" as="geometry" />
        </mxCell>
        <mxCell id="a_q" value="&lt;div style=&quot;font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B&quot;&gt;FUTURE&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#141210;margin-top:1px&quot;&gt;Queue&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#3B3630;margin-top:2px&quot;&gt;Amazon SQS with a dead-letter queue: proposal render and send, PMS writes behind an approval gate, webhook ingest.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#F2EEE7;strokeColor=#2E2A26;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="c_async">
          <mxGeometry x="20" y="56" width="340" height="96" as="geometry" />
        </mxCell>
        <mxCell id="a_w" value="&lt;div style=&quot;font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B&quot;&gt;FUTURE&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#141210;margin-top:1px&quot;&gt;Workers&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#3B3630;margin-top:2px&quot;&gt;Idempotent container workers. Retry with backoff; the dead-letter queue is alerted on, never drained silently.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#F2EEE7;strokeColor=#2E2A26;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="c_async">
