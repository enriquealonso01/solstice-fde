        </mxCell>
        <mxCell id="t_title" value="<div style="font-size:26px;font-weight:700;color:#141210">Today - the MVP that runs at the demo (2026-09-27)</div><div style="font-size:13px;color:#3B3630;margin-top:3px">One deployed application on Netlify plus one Supabase project. Everything here is real; the blocked pieces are blocked outside the code.</div>" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;spacingRight=10;fillColor=#FFFFFF;strokeColor=#6B625A;strokeWidth=2;fontSize=12;fontColor=#141210;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1160" height="74" as="geometry" />
        </mxCell>
        <mxCell id="t_legend" value="<div style="font-size:13px;font-weight:700">Status, honestly</div><div style="font-size:11px;margin-top:4px"><b>LIVE</b> (solid) is running. <b>PENDING</b> (dashed) is written and waiting on an account.<br/><b>BLOCKED</b> (dotted, thick) is written and blocked by something outside the code:<br/>the Anthropic key is not workspace-scoped, and 10DLC carrier registration cannot clear in time.</div>" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;spacingRight=10;fillColor=#FFFFFF;strokeColor=#6B625A;strokeWidth=2;fontSize=12;fontColor=#141210;" vertex="1" parent="1">
          <mxGeometry x="1220" y="20" width="1180" height="74" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="degrade" name="Degradation and failover">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2240" pageHeight="1130" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="d_title" value="<div style="font-size:26px;font-weight:700;color:#141210">Degradation paths - future state</div><div style="font-size:13px;color:#3B3630;margin-top:3px">Every row is a real upstream failure, the mechanism that absorbs it, and what the guest and the staff actually see.</div>" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;spacingRight=10;fillColor=#FFFFFF;strokeColor=#6B625A;strokeWidth=2;fontSize=12;fontColor=#141210;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2180" height="74" as="geometry" />
        </mxCell>
        <mxCell id="dh_60" value="Upstream failure" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDE5D8;strokeColor=#6B625A;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#141210;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="660" height="40" as="geometry" />
        </mxCell>
        <mxCell id="dh_760" value="Mechanism" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDE5D8;strokeColor=#6B625A;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#141210;" vertex="1" parent="1">
          <mxGeometry x="760" y="120" width="660" height="40" as="geometry" />
        </mxCell>
        <mxCell id="dh_1460" value="What the guest and staff see" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDE5D8;strokeColor=#6B625A;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#141210;" vertex="1" parent="1">
          <mxGeometry x="1460" y="120" width="660" height="40" as="geometry" />
        </mxCell>
        <mxCell id="dr0_0" value="<div style="font-size:13px;font-weight:700;color:#141210">PMS or CRS unreachable</div>" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fillColor=#FFFFFF;strokeColor=#8C2F1F;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=12;fontColor=#141210;" vertex="1" parent="1">
          <mxGeometry x="60" y="172" width="660" height="130" as="geometry" />
        </mxCell>
        <mxCell id="da0_0" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#3B3630;strokeWidth=1.6;endArrow=blockThin;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="720" y="237" as="sourcePoint" />
            <mxPoint x="760" y="237" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dr0_1" value="<div style="font-size:12px;color:#3B3630">Circuit breaker opens after three failures. Reads fall to the Redis cache with a stale_as_of stamp.</div>" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fillColor=#F2EEE7;strokeColor=#2E2A26;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=12;fontColor=#141210;" vertex="1" parent="1">
          <mxGeometry x="760" y="172" width="660" height="130" as="geometry" />
        </mxCell>
        <mxCell id="da0_1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#3B3630;strokeWidth=1.6;endArrow=blockThin;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1420" y="237" as="sourcePoint" />
            <mxPoint x="1460" y="237" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dr0_2" value="<div style="font-size:12px;color:#3B3630">Sol quotes the cached stay and says how old it is. With no cache: grounded:false, &quot;I cannot confirm that&quot;, escalation plus callback.</div>" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fillColor=#FFFFFF;strokeColor=#1F5C3D;strokeWidth=2;dashed=0;dashPattern=8 4;fontSize=12;fontColor=#141210;" vertex="1" parent="1">
          <mxGeometry x="1460" y="172" width="660" height="130" as="geometry" />
        </mxCell>
        <mxCell id="dr1_0" value="<div style="font-size:13px;font-weight:700;color:#141210">Model provider down or throttled</div>" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fillColor=#FFFFFF;strokeColor=#8C2F1F;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=12;fontColor=#141210;" vertex="1" parent="1">
          <mxGeometry x="60" y="318" width="660" height="130" as="geometry" />
        </mxCell>
        <mxCell id="da1_0" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#3B3630;strokeWidth=1.6;endArrow=blockThin;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="720" y="383" as="sourcePoint" />
            <mxPoint x="760" y="383" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dr1_1" value="<div style="font-size:12px;color:#3B3630">Model gateway retries with backoff, then fails over from the Anthropic API to Amazon Bedrock (Claude).</div>" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fillColor=#F2EEE7;strokeColor=#2E2A26;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=12;fontColor=#141210;" vertex="1" parent="1">
          <mxGeometry x="760" y="318" width="660" height="130" as="geometry" />
        </mxCell>
        <mxCell id="da1_1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#3B3630;strokeWidth=1.6;endArrow=blockThin;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1420" y="383" as="sourcePoint" />
            <mxPoint x="1460" y="383" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dr1_2" value="<div style="font-size:12px;color:#3B3630">Nothing visible. If both are down, chat answers only what the rules engine proves and offers a human; voice transfers.</div>" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fillColor=#FFFFFF;strokeColor=#1F5C3D;strokeWidth=2;dashed=0;dashPattern=8 4;fontSize=12;fontColor=#141210;" vertex="1" parent="1">
          <mxGeometry x="1460" y="318" width="660" height="130" as="geometry" />
        </mxCell>
        <mxCell id="dr2_0" value="<div style="font-size:13px;font-weight:700;color:#141210">Telephony degraded</div>" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fillColor=#FFFFFF;strokeColor=#8C2F1F;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=12;fontColor=#141210;" vertex="1" parent="1">
          <mxGeometry x="60" y="464" width="660" height="130" as="geometry" />
        </mxCell>
        <mxCell id="da2_0" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#3B3630;strokeWidth=1.6;endArrow=blockThin;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="720" y="529" as="sourcePoint" />
            <mxPoint x="760" y="529" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dr2_1" value="<div style="font-size:12px;color:#3B3630">Standby DID on a second carrier. The displayed number is runtime config, so it changes without a deploy.</div>" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fillColor=#F2EEE7;strokeColor=#2E2A26;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=12;fontColor=#141210;" vertex="1" parent="1">
          <mxGeometry x="760" y="464" width="660" height="130" as="geometry" />
        </mxCell>
        <mxCell id="da2_1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#3B3630;strokeWidth=1.6;endArrow=blockThin;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1420" y="529" as="sourcePoint" />
            <mxPoint x="1460" y="529" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dr2_2" value="<div style="font-size:12px;color:#3B3630">The call connects. If the assistant is unhealthy, the call forwards to central reservations and still opens a session row.</div>" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fillColor=#FFFFFF;strokeColor=#1F5C3D;strokeWidth=2;dashed=0;dashPattern=8 4;fontSize=12;fontColor=#141210;" vertex="1" parent="1">
          <mxGeometry x="1460" y="464" width="660" height="130" as="geometry" />
        </mxCell>
        <mxCell id="dr3_0" value="<div style="font-size:13px;font-weight:700;color:#141210">Email or SMS provider fails</div>" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fillColor=#FFFFFF;strokeColor=#8C2F1F;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=12;fontColor=#141210;" vertex="1" parent="1">
          <mxGeometry x="60" y="610" width="660" height="130" as="geometry" />
        </mxCell>
        <mxCell id="da3_0" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#3B3630;strokeWidth=1.6;endArrow=blockThin;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="720" y="675" as="sourcePoint" />
            <mxPoint x="760" y="675" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dr3_1" value="<div style="font-size:12px;color:#3B3630">The channel adapter picks the next sender (Amazon SES). Nothing above the adapter changes.</div>" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fillColor=#F2EEE7;strokeColor=#2E2A26;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=12;fontColor=#141210;" vertex="1" parent="1">
          <mxGeometry x="760" y="610" width="660" height="130" as="geometry" />
        </mxCell>
        <mxCell id="da3_1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#3B3630;strokeWidth=1.6;endArrow=blockThin;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1420" y="675" as="sourcePoint" />
            <mxPoint x="1460" y="675" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dr3_2" value="<div style="font-size:12px;color:#3B3630">The proposal arrives by another route. If all senders fail it stays queued and the console reads not sent, never sent.</div>" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fillColor=#FFFFFF;strokeColor=#1F5C3D;strokeWidth=2;dashed=0;dashPattern=8 4;fontSize=12;fontColor=#141210;" vertex="1" parent="1">
          <mxGeometry x="1460" y="610" width="660" height="130" as="geometry" />
        </mxCell>
        <mxCell id="dr4_0" value="<div style="font-size:13px;font-weight:700;color:#141210">Database write outage</div>" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fillColor=#FFFFFF;strokeColor=#8C2F1F;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=12;fontColor=#141210;" vertex="1" parent="1">
          <mxGeometry x="60" y="756" width="660" height="130" as="geometry" />
        </mxCell>
        <mxCell id="da4_0" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#3B3630;strokeWidth=1.6;endArrow=blockThin;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="720" y="821" as="sourcePoint" />
            <mxPoint x="760" y="821" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dr4_1" value="<div style="font-size:12px;color:#3B3630">RDS Multi-AZ failover. The app flips to read-only; new turns buffer in SQS and replay in order.</div>" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fillColor=#F2EEE7;strokeColor=#2E2A26;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=12;fontColor=#141210;" vertex="1" parent="1">
          <mxGeometry x="760" y="756" width="660" height="130" as="geometry" />
        </mxCell>
        <mxCell id="da4_1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#3B3630;strokeWidth=1.6;endArrow=blockThin;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1420" y="821" as="sourcePoint" />
            <mxPoint x="1460" y="821" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dr4_2" value="<div style="font-size:12px;color:#3B3630">Chat keeps answering from cache. Transcripts backfill within seconds of recovery; the dead-letter queue is alerted on.</div>" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fillColor=#FFFFFF;strokeColor=#1F5C3D;strokeWidth=2;dashed=0;dashPattern=8 4;fontSize=12;fontColor=#141210;" vertex="1" parent="1">
          <mxGeometry x="1460" y="756" width="660" height="130" as="geometry" />
        </mxCell>
        <mxCell id="dr5_0" value="<div style="font-size:13px;font-weight:700;color:#141210">Realtime stream drops</div>" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fillColor=#FFFFFF;strokeColor=#8C2F1F;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=12;fontColor=#141210;" vertex="1" parent="1">
          <mxGeometry x="60" y="902" width="660" height="130" as="geometry" />
        </mxCell>
        <mxCell id="da5_0" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#3B3630;strokeWidth=1.6;endArrow=blockThin;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="720" y="967" as="sourcePoint" />
            <mxPoint x="760" y="967" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dr5_1" value="<div style="font-size:12px;color:#3B3630">The supervisor console falls back to five-second polling against Postgres.</div>" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fillColor=#F2EEE7;strokeColor=#2E2A26;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=12;fontColor=#141210;" vertex="1" parent="1">
          <mxGeometry x="760" y="902" width="660" height="130" as="geometry" />
        </mxCell>
        <mxCell id="da5_1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#3B3630;strokeWidth=1.6;endArrow=blockThin;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1420" y="967" as="sourcePoint" />
            <mxPoint x="1460" y="967" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dr5_2" value="<div style="font-size:12px;color:#3B3630">A live updates degraded banner. The transcript still reconstructs from the same rows the archive reads.</div>" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fillColor=#FFFFFF;strokeColor=#1F5C3D;strokeWidth=2;dashed=0;dashPattern=8 4;fontSize=12;fontColor=#141210;" vertex="1" parent="1">
          <mxGeometry x="1460" y="902" width="660" height="130" as="geometry" />
        </mxCell>
        <mxCell id="d_foot" value="<div style="font-size:13px;font-weight:700;color:#141210">The rule underneath all six: degrade to a smaller, honest answer plus a human. Never to a confident guess.</div><div style="font-size:12px;color:#3B3630;margin-top:4px">A tool that cannot ground an answer returns grounded:false, and grounded:false is a machine-checkable order to escalate rather than improvise. That is why every row above ends in an honest sentence and a human, not a guess.</div>" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;spacingRight=10;fillColor=#FFFDF9;strokeColor=#6B625A;strokeWidth=2;fontSize=12;fontColor=#141210;" vertex="1" parent="1">
          <mxGeometry x="60" y="1058" width="2060" height="92" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
