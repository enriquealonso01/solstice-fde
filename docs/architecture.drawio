        <mxCell id="y_guest" value="&lt;div style=&quot;font-size:15px;font-weight:700;color:#141210&quot;&gt;Guest side&lt;/div&gt;&lt;div style=&quot;font-size:10px;font-weight:400;color:#5A534B&quot;&gt;Public, one Netlify deploy&lt;/div&gt;" style="swimlane;html=1;startSize=56;rounded=1;arcSize=3;fillColor=#EDE5D8;strokeColor=#6B625A;strokeWidth=2;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;swimlaneFillColor=#FBF8F3;horizontal=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="340" height="388" as="geometry" />
        </mxCell>
        <mxCell id="y_land" value="&lt;div style=&quot;font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B&quot;&gt;LIVE&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#141210;margin-top:1px&quot;&gt;Landing page&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#3B3630;margin-top:2px&quot;&gt;Netlify CDN. Typography-driven, no stock photography, support number displayed.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#FFFFFF;strokeColor=#1F5C3D;strokeWidth=2;dashed=0;" vertex="1" parent="y_guest">
          <mxGeometry x="20" y="56" width="300" height="96" as="geometry" />
        </mxCell>
        <mxCell id="y_bub" value="&lt;div style=&quot;font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B&quot;&gt;LIVE&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#141210;margin-top:1px&quot;&gt;Chat bubble&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#3B3630;margin-top:2px&quot;&gt;React. Streaming replies, typing indicator, tool chips, inline policy citations.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#FFFFFF;strokeColor=#1F5C3D;strokeWidth=2;dashed=0;" vertex="1" parent="y_guest">
          <mxGeometry x="20" y="166" width="300" height="96" as="geometry" />
        </mxCell>
        <mxCell id="y_ph" value="&lt;div style=&quot;font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B&quot;&gt;PENDING&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#141210;margin-top:1px&quot;&gt;Support phone number&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#3B3630;margin-top:2px&quot;&gt;Telnyx DID, reused from a retired connection. Waiting on account funding.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#FFFFFF;strokeColor=#8A6A1F;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="y_guest">
          <mxGeometry x="20" y="276" width="300" height="96" as="geometry" />
        </mxCell>
        <mxCell id="y_dep" value="&lt;div style=&quot;font-size:15px;font-weight:700;color:#141210&quot;&gt;Deploy&lt;/div&gt;&lt;div style=&quot;font-size:10px;font-weight:400;color:#5A534B&quot;&gt;One repo, one build&lt;/div&gt;" style="swimlane;html=1;startSize=56;rounded=1;arcSize=3;fillColor=#EDE5D8;strokeColor=#6B625A;strokeWidth=2;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;swimlaneFillColor=#FBF8F3;horizontal=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="648" width="340" height="388" as="geometry" />
        </mxCell>
        <mxCell id="y_repo" value="&lt;div style=&quot;font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B&quot;&gt;LIVE&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#141210;margin-top:1px&quot;&gt;Repository&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#3B3630;margin-top:2px&quot;&gt;App, functions, schema, agent definition and plans in one place.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#FFFFFF;strokeColor=#1F5C3D;strokeWidth=2;dashed=0;" vertex="1" parent="y_dep">
          <mxGeometry x="20" y="56" width="300" height="96" as="geometry" />
        </mxCell>
        <mxCell id="y_build" value="&lt;div style=&quot;font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B&quot;&gt;LIVE&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#141210;margin-top:1px&quot;&gt;Netlify build&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#3B3630;margin-top:2px&quot;&gt;vite build to dist, esbuild bundling for netlify/functions, /api/* rewrite.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#FFFFFF;strokeColor=#1F5C3D;strokeWidth=2;dashed=0;" vertex="1" parent="y_dep">
          <mxGeometry x="20" y="166" width="300" height="96" as="geometry" />
        </mxCell>
        <mxCell id="y_env" value="&lt;div style=&quot;font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B&quot;&gt;LIVE&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#141210;margin-top:1px&quot;&gt;Secret boundary&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#3B3630;margin-top:2px&quot;&gt;Only SUPABASE_URL and the anon key reach the bundle. Service role, Telnyx and Anthropic keys stay server-side.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#FFFFFF;strokeColor=#1F5C3D;strokeWidth=2;dashed=0;" vertex="1" parent="y_dep">
          <mxGeometry x="20" y="276" width="300" height="96" as="geometry" />
        </mxCell>
        <mxCell id="y_rt" value="&lt;div style=&quot;font-size:15px;font-weight:700;color:#141210&quot;&gt;Runtimes&lt;/div&gt;&lt;div style=&quot;font-size:10px;font-weight:400;color:#5A534B&quot;&gt;Two engines, one definition&lt;/div&gt;" style="swimlane;html=1;startSize=56;rounded=1;arcSize=3;fillColor=#EDE5D8;strokeColor=#6B625A;strokeWidth=2;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;swimlaneFillColor=#FBF8F3;horizontal=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="110" width="380" height="498" as="geometry" />
        </mxCell>
        <mxCell id="y_chat" value="&lt;div style=&quot;font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B&quot;&gt;PENDING&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#141210;margin-top:1px&quot;&gt;/api/chat&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#3B3630;margin-top:2px&quot;&gt;Netlify Function. Holds the Anthropic key, runs the tool loop, writes every turn to Postgres.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#FFFFFF;strokeColor=#8A6A1F;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="y_rt">
          <mxGeometry x="20" y="56" width="340" height="96" as="geometry" />
        </mxCell>
        <mxCell id="y_claude" value="&lt;div style=&quot;font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B&quot;&gt;BLOCKED&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#141210;margin-top:1px&quot;&gt;Claude (Anthropic API)&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#3B3630;margin-top:2px&quot;&gt;Key is not workspace-scoped and currently 400s. Code is written against the contract.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#FFFFFF;strokeColor=#8C2F1F;strokeWidth=3;dashed=1;dashPattern=2 3;" vertex="1" parent="y_rt">
