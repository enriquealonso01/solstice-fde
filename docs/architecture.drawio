        <mxCell id="c_obs" value="&lt;div style=&quot;font-size:15px;font-weight:700;color:#141210&quot;&gt;Observability, operations and release&lt;/div&gt;&lt;div style=&quot;font-size:10px;font-weight:400;color:#5A534B&quot;&gt;Cross-cutting: every service above emits here&lt;/div&gt;" style="swimlane;html=1;startSize=56;rounded=1;arcSize=3;fillColor=#EDE5D8;strokeColor=#6B625A;strokeWidth=2;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;swimlaneFillColor=#FBF8F3;horizontal=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="1446" width="2420" height="168" as="geometry" />
        </mxCell>
        <mxCell id="o_ci" value="&lt;div style=&quot;font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B&quot;&gt;FUTURE&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#141210;margin-top:1px&quot;&gt;CI/CD and release gates&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#3B3630;margin-top:2px&quot;&gt;GitHub Actions to an image, rolling ECS deploy. Typecheck, rules tests and a golden-transcript run gate every release.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#F2EEE7;strokeColor=#2E2A26;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="c_obs">
          <mxGeometry x="20" y="56" width="320" height="96" as="geometry" />
        </mxCell>
        <mxCell id="o_log" value="&lt;div style=&quot;font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B&quot;&gt;FUTURE&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#141210;margin-top:1px&quot;&gt;Structured logs&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#3B3630;margin-top:2px&quot;&gt;JSON correlated by session_id to CloudWatch Logs. Masked at the source, so no log can leak PII.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#F2EEE7;strokeColor=#2E2A26;strokeWidth=2;dashed=1;dashPattern=8 4;" vertex="1" parent="c_obs">
