        </mxCell>
        <mxCell id="y_tools" value="&lt;div style=&quot;font-size:15px;font-weight:700;color:#141210&quot;&gt;Tool layer&lt;/div&gt;&lt;div style=&quot;font-size:10px;font-weight:400;color:#5A534B&quot;&gt;Netlify Functions, shared by both runtimes&lt;/div&gt;" style="swimlane;html=1;startSize=56;rounded=1;arcSize=3;fillColor=#EDE5D8;strokeColor=#6B625A;strokeWidth=2;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;swimlaneFillColor=#FBF8F3;horizontal=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="648" width="380" height="498" as="geometry" />
        </mxCell>
        <mxCell id="y_tl" value="&lt;div style=&quot;font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B&quot;&gt;LIVE&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#141210;margin-top:1px&quot;&gt;Shared tool layer&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#3B3630;margin-top:2px&quot;&gt;Concierge tools and group tools. One implementation, so voice and chat cannot diverge.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#FFFFFF;strokeColor=#1F5C3D;strokeWidth=2;dashed=0;" vertex="1" parent="y_tools">
          <mxGeometry x="20" y="56" width="340" height="96" as="geometry" />
        </mxCell>
        <mxCell id="y_rules" value="&lt;div style=&quot;font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B&quot;&gt;LIVE&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#141210;margin-top:1px&quot;&gt;Rules as data&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#3B3630;margin-top:2px&quot;&gt;src/lib/rules: thresholds, seasonal caps, blackouts. Changing one is a one-line edit.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#FFFFFF;strokeColor=#1F5C3D;strokeWidth=2;dashed=0;" vertex="1" parent="y_tools">
          <mxGeometry x="20" y="166" width="340" height="96" as="geometry" />
        </mxCell>
        <mxCell id="y_av" value="&lt;div style=&quot;font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B&quot;&gt;LIVE&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#141210;margin-top:1px&quot;&gt;availability_service&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#3B3630;margin-top:2px&quot;&gt;The net-new tool. Deterministic simulated inventory, stamped simulated_inventory_service.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#FFFFFF;strokeColor=#1F5C3D;strokeWidth=2;dashed=0;" vertex="1" parent="y_tools">
          <mxGeometry x="20" y="276" width="340" height="96" as="geometry" />
        </mxCell>
        <mxCell id="y_envl" value="&lt;div style=&quot;font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B&quot;&gt;LIVE&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#141210;margin-top:1px&quot;&gt;ToolResult envelope&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#3B3630;margin-top:2px&quot;&gt;ok, grounded, citations, masked_fields, latency_ms on every tool without exception.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#FFFFFF;strokeColor=#1F5C3D;strokeWidth=2;dashed=0;" vertex="1" parent="y_tools">
          <mxGeometry x="20" y="386" width="340" height="96" as="geometry" />
        </mxCell>
        <mxCell id="y_data" value="&lt;div style=&quot;font-size:15px;font-weight:700;color:#141210&quot;&gt;Data&lt;/div&gt;&lt;div style=&quot;font-size:10px;font-weight:400;color:#5A534B&quot;&gt;One Supabase project&lt;/div&gt;" style="swimlane;html=1;startSize=56;rounded=1;arcSize=3;fillColor=#EDE5D8;strokeColor=#6B625A;strokeWidth=2;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;swimlaneFillColor=#FBF8F3;horizontal=1;" vertex="1" parent="1">
          <mxGeometry x="840" y="110" width="380" height="608" as="geometry" />
        </mxCell>
        <mxCell id="y_pg" value="&lt;div style=&quot;font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B&quot;&gt;LIVE&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#141210;margin-top:1px&quot;&gt;Postgres and RLS&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#3B3630;margin-top:2px&quot;&gt;Concierge cannot read inquiries, group sales cannot read messages. Scoping is a database policy.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#FFFFFF;strokeColor=#1F5C3D;strokeWidth=2;dashed=0;" vertex="1" parent="y_data">
          <mxGeometry x="20" y="56" width="340" height="96" as="geometry" />
        </mxCell>
        <mxCell id="y_rtm" value="&lt;div style=&quot;font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B&quot;&gt;LIVE&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#141210;margin-top:1px&quot;&gt;Realtime&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#3B3630;margin-top:2px&quot;&gt;postgres_changes on sessions, messages, tool_invocations, inquiries and proposals.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#FFFFFF;strokeColor=#1F5C3D;strokeWidth=2;dashed=0;" vertex="1" parent="y_data">
          <mxGeometry x="20" y="166" width="340" height="96" as="geometry" />
        </mxCell>
        <mxCell id="y_st" value="&lt;div style=&quot;font-size:9px;font-weight:700;letter-spacing:1px;color:#5A534B&quot;&gt;LIVE&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:700;color:#141210;margin-top:1px&quot;&gt;Storage&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#3B3630;margin-top:2px&quot;&gt;Generated proposal PDFs, handed out as time-limited signed URLs.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=0;spacingRight=6;fontSize=12;fontColor=#141210;fillColor=#FFFFFF;strokeColor=#1F5C3D;strokeWidth=2;dashed=0;" vertex="1" parent="y_data">
          <mxGeometry x="20" y="276" width="340" height="96" as="geometry" />
        </mxCell>
