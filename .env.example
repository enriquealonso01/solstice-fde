# Copy to .env and fill. Never commit .env.
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_ASSISTANT_ID=
TELNYX_PHONE_NUMBER=
TELNYX_SIP_USERNAME=
TELNYX_SIP_PASSWORD=
TELNYX_EMAIL_FROM=

ANTHROPIC_API_KEY=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

DEMO_EMAIL=
DEMO_PHONE=
DEMO_MODE=true
AUTO_SEND=false

# Shared secret for the assistant-facing tool routes (/api/tools/<name>, /api/group/tool).
# MUST be identical here, in .env, and in the Netlify environment: provisioning bakes the
# .env value into the Telnyx assistant config, so a mismatch 401s every tool call.
# Leaving it unset leaves those routes OPEN to the internet.
TOOL_WEBHOOK_SECRET=

# Voice model + TTS voice for Sol, and the public origin used to build webhook URLs.
TELNYX_ASSISTANT_MODEL=anthropic/claude-haiku-4-5
TELNYX_ASSISTANT_VOICE=Azure.en-US-Ava:DragonHDLatestNeural
PUBLIC_BASE_URL=

# Latency dial: 'disabled' turns off extended thinking on the chat brain.
SOL_THINKING=
