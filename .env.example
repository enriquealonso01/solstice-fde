# Copy to .env and fill. Never commit .env.
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_ASSISTANT_ID=
TELNYX_PHONE_NUMBER=
TELNYX_SIP_USERNAME=
TELNYX_SIP_PASSWORD=
TELNYX_EMAIL_FROM=

ANTHROPIC_API_KEY=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

DEMO_EMAIL=
DEMO_PHONE=
DEMO_MODE=true
AUTO_SEND=false

# Password given to every seeded staff account by `npm run seed:users` (README, "Running it
# locally", step 5). Deliberately not defaulted: the script refuses to run without it rather than
# create demo logins with a password someone could guess from this repo.
DEMO_PASSWORD=

# Only needed if you want `npm run db:schema` to apply supabase/schema.sql for you (step 3).
# Without it that command prints the SQL-editor instructions instead and exits cleanly.
# Supabase > Project Settings > Database > Connection string > URI.
SUPABASE_DB_URL=

# Shared secret for the assistant-facing tool routes (/api/tools/<name>, /api/group/tool).
# MUST be identical here, in .env, and in the Netlify environment: provisioning bakes the
# .env value into the Telnyx assistant config, so a mismatch 401s every tool call.
# Leaving it unset leaves those routes OPEN to the internet.
TOOL_WEBHOOK_SECRET=

# Voice model + TTS voice for Sol, and the public origin used to build webhook URLs.
TELNYX_ASSISTANT_MODEL=anthropic/claude-haiku-4-5
TELNYX_ASSISTANT_VOICE=Azure.en-US-Ava:DragonHDLatestNeural
PUBLIC_BASE_URL=

# Extended thinking on the chat brain. Ship 'disabled'. This is a behaviour setting, not a speed one:
# it is slower to first token and it was the only configuration that produced zero behavioural
# violations across the four adversarial scenarios -- with adaptive on, Sol created a real escalation
# and then did not tell the guest it had done so. Blank is NOT neutral: chat.ts reads anything other
# than 'disabled' as adaptive. See docs/latency-target.md, "What we traded, deliberately".
SOL_THINKING=disabled
